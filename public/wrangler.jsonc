{
  // Clearfigure public site: deploy with `npx wrangler deploy -c public/wrangler.jsonc` from the repo root, after
  // `node tools/build-public.mjs` (see public/README.md). Separate from the private site (../wrangler.jsonc):
  // no Cloudflare Access, no sync bucket. Paths here are relative to this file.
  "name": "clearfigure",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Contact-form messages only. Create once (EU jurisdiction): npx wrangler r2 bucket create clearfigure-leads --jurisdiction eu
  "r2_buckets": [{ "binding": "LEADS", "bucket_name": "clearfigure-leads", "jurisdiction": "eu" }],
  "observability": { "enabled": false }
  // A custom domain later: add  "routes": [{ "pattern": "www.example.si", "custom_domain": true }]  (public/README.md)
}
